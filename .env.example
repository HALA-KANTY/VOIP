# Copier ce fichier vers .env puis renseigner de vraies valeurs avant de lancer
# `docker compose up -d`. Ne jamais committer le fichier .env reel.

# --- PostgreSQL ---
POSTGRES_USER=voip_user
POSTGRES_PASSWORD=change_moi_mot_de_passe_postgres
POSTGRES_DB=voip_billing

# --- Backend : Asterisk AMI ---
# Hote/port de l'AMI Asterisk (serveur gere separement, cf DEPLOYMENT.md).
ASTERISK_AMI_HOST=asterisk.example.com
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=fastapi
ASTERISK_AMI_SECRET=change_moi_secret_ami

# Secret partage entre Asterisk (dialplan) et les endpoints /api/check_balance
# et /api/end_call. Doit correspondre a la valeur utilisee dans le dialplan.
AMI_ENDPOINTS_SECRET=change_moi_secret_endpoints

# --- Backend : JWT ---
JWT_SECRET_KEY=change_moi_avec_une_cle_aleatoire_longue
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# --- Backend : tarification et admin par defaut ---
TARIF_DEFAUT=1.0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_moi_mot_de_passe_admin

# --- Backend : CORS ---
# Domaine(s) autorises a appeler l'API (celui de l'interface admin).
# En path-based routing derriere le meme nginx/domaine, https://DOMAIN suffit.
CORS_ORIGINS=https://voip.example.com

# --- Frontend ---
# Doit pointer vers l'origine publique de l'API telle que vue par le
# navigateur (donc le domaine + /api en reverse proxy nginx), PAS l'adresse
# interne du conteneur backend. Fourni au build (voir DEPLOYMENT.md).
NEXT_PUBLIC_API_URL=https://voip.example.com

# --- nginx / TLS ---
DOMAIN=voip.example.com
