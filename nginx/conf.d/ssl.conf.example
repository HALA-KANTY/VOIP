# Phase 2 (apres obtention des certificats Let's Encrypt, voir DEPLOYMENT.md) :
# remplace nginx/conf.d/default.conf par une copie de ce fichier avec
# <VOTRE_DOMAINE> remplace par le vrai nom de domaine, puis :
#   docker compose exec nginx nginx -s reload

upstream backend_upstream {
    server backend:8000;
}

upstream frontend_upstream {
    server admin_web:3000;
}

server {
    listen 80;
    server_name <VOTRE_DOMAINE>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name <VOTRE_DOMAINE>;

    client_max_body_size 10m;

    ssl_certificate     /etc/letsencrypt/live/<VOTRE_DOMAINE>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<VOTRE_DOMAINE>/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=63072000" always;

    location /api/ {
        proxy_pass http://backend_upstream;
        include /etc/nginx/proxy_params.conf;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/(docs|redoc|openapi\.json|health)$ {
        proxy_pass http://backend_upstream;
        include /etc/nginx/proxy_params.conf;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://frontend_upstream;
        include /etc/nginx/proxy_params.conf;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
