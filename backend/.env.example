# Base de donnees
DATABASE_URL=postgresql+asyncpg://voip_user:voip_password_secure@postgres:5432/voip_billing

# Asterisk AMI
ASTERISK_AMI_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=fastapi
ASTERISK_AMI_SECRET=motdepasse_ami_fastapi

# Secret partage pour les endpoints appeles par Asterisk (/api/check_balance, /api/end_call)
AMI_ENDPOINTS_SECRET=change_moi_secret_partage

# JWT
JWT_SECRET_KEY=votre_cle_secrete_a_changer
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Tarification
TARIF_DEFAUT=1.0

# CORS (liste d'origines separees par des virgules)
CORS_ORIGINS=http://localhost:5173

# Admin par defaut cree au demarrage si aucun admin n'existe
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_moi_mot_de_passe
